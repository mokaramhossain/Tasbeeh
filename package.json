  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist",
    "lint": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "i18n:report": "node scripts/i18n-report.mjs",
    "images": "node scripts/build-share-images.mjs",
    "data:hadiths": "node scripts/build-hadiths.mjs",
    "data:names": "node scripts/build-names.mjs",
    "data:verify-names": "node scripts/verify-name-verses.mjs",
    "data:name-verses": "node scripts/build-name-verses.mjs",
    "i18n:todo": "node scripts/translation-todo.mjs",
    "i18n:apply": "node scripts/apply-translations.mjs",
    "shots": "node scripts/build-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
